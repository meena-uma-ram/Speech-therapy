{
  "name": "tjs-pay",
  "version": "0.1.0",
  "private": true,
  "description": "TJS Pay: session-to-paid billing for independent therapy practices, with PayPal and AI.",
  "license": "AGPL-3.0-or-later",
  "author": "Meenakshi Ramesh",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:mock": "wrangler dev --var PAYPAL_MODE:mock",
    "db:local": "wrangler d1 execute tjs-pay --local --file=schema.sql",
    "db:remote": "wrangler d1 execute tjs-pay --remote --file=schema.sql",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "qrcode-generator": "^1.4.4"
  }
}
