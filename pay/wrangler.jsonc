// TJS Pay: PayPal + AI billing for independent therapy practices.
// A separate Worker from the main TJS app, so the live TJS deploy is never affected.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tjs-pay",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/paid", "/paid.html", "/checkin", "/checkin.html"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "tjs-pay", "database_id": "REPLACE_WITH_YOUR_D1_ID" }
  ],
  // Every hour: check PayPal for payments. At 09:00 UTC also send reminders that are due.
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    // "sandbox" talks to the PayPal sandbox. "mock" simulates PayPal for local testing only.
    "PAYPAL_MODE": "sandbox",
    // Short writing jobs (invoice notes, reading payments, rewording reminders)
    "AI_MODEL": "claude-haiku-5-5",
    // The billing assistant, which plans with tools
    "AGENT_MODEL": "claude-opus-5-5",
    // Most AI requests per day (UTC). After that, standard wording and built-in rules take over.
    "AI_DAILY_LIMIT": "150",
    "CURRENCY": "GBP",
    "PRACTICE_NAME": "Northern Voices Speech Therapy"
  }
}
